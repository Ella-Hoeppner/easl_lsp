{
  "name": "sse-language-client",
  "displayName": "SSE Language Client",
  "description": "Language support for the SSE format",
  "version": "0.0.1",
  "license": "see LICENSE.md",
  "engines": {
    "vscode": "^1.91.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ella-Hoeppner/SSE-language-server"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:sse"],
  "contributes": {
    "commands": [
      {
        "command": "extension.expandSelection",
        "title": "SSE: Expand Selection"
      },
      {
        "command": "extension.moveCursorToStart",
        "title": "SSE: Move Cursor Left of the Current Form"
      },
      {
        "command": "extension.moveCursorToEnd",
        "title": "SSE: Move Cursor Right of the Current Form"
      }
    ],
    "keybindings": [
      {
        "command": "extension.expandSelection",
        "key": "ctrl+w",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.moveCursorToStart",
        "key": "ctrl+a",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.moveCursorToEnd",
        "key": "ctrl+d",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.handleBackspace",
        "key": "backspace",
        "when": "editorTextFocus && editorLangId == sse"
      }
    ],
    "languages": [
      {
        "id": "sse",
        "aliases": ["SSE", "sse"],
        "extensions": [".sse", ".easl"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "files": ["LICENSE.md", "language-configuration.json", "out/**/*"],
  "scripts": {
    "build": "webpack --mode production && node build.js",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/vscode": "^1.91.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
